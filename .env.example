# OAuth client ID for Google Sheets sync.
# The app runs without this — your data just stays in the browser.
# See the README for how to create one (about five minutes).
VITE_GOOGLE_CLIENT_ID=

# Optional access gate. Comma-separated emails allowed to use the app after
# signing in with Google. Leave empty for no gate. It is a soft, client-side
# check and the emails are visible in the built code.
VITE_ALLOWED_EMAILS=
